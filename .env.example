# Copy this file to .env.local and fill in values.
# Never commit .env.local (it is gitignored).

# Google Drive folder ID from the folder URL:
# https://drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=

# Full JSON for a Google Cloud service account key (single line or pasted as-is).
# Share the Drive folder with that service account email as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: polish teaching cards with OpenAI. Leave blank for retrieval-only.
OPENAI_API_KEY=
