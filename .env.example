# Copy to .env.local (gitignored). Restart npm run dev after changes.

# From the Drive folder URL: https://drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=

# Easiest on Windows: put the downloaded service-account JSON here:
#   credentials/google-service-account.json
# Then you can leave the next two blank.
#
# Or point at the file explicitly (use forward slashes):
# GOOGLE_SERVICE_ACCOUNT_FILE=C:/Users/You/Downloads/your-key.json

GOOGLE_SERVICE_ACCOUNT_FILE=

# Harder option: paste the entire JSON as one line (often breaks on Windows).
# Prefer the file methods above.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional LLM polish
OPENAI_API_KEY=
