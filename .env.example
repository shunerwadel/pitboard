# Copy to .env.local (gitignored). Restart npm run dev after any change.

# --- OpenAI (AI extend: analogies, charts, diagrams) ---
# Create a key at https://platform.openai.com/api-keys
# This is the Platform API key — not a ChatGPT Plus login.
# Paste the key on one line, no quotes:
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3

# --- Google Drive (optional live materials sync) ---
# From the Drive folder URL: https://drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=

# Easiest on Windows: put the service-account JSON here:
#   credentials/google-service-account.json
# Then leave the next two blank.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
